{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kanban-disetight-band-76ce",
  "main": "src/handler.js",
  "compatibility_date": "2026-03-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Cron de CF saturado (5/5 en la cuenta). El trigger semanal vive en
  // GitHub Actions: .github/workflows/viernes-3pm.yml dispara POST /report/notify
  // los viernes 21:00 UTC (= 15:00 MX). No descomentar el bloque triggers.crons
  // sin antes verificar que libero un cron en otro Worker.
  // "triggers": { "crons": ["0 21 * * 5"] },
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": true }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "342fe96c3658473eb3dc03407c31a6e6"
    }
  ]
}
